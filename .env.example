# ============================================================
# PlacementOS — Environment Variables Reference
# Copy the server block into apps/server/.env
# Copy the frontend block into apps/web/.env
# NEVER commit .env files to version control.
# ============================================================

# ── SERVER ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (own database — independent from SchoolOS)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Allowed CORS origin (frontend URL)
FRONTEND_URL=http://localhost:5173

# Institute display name (used in notifications, emails, etc.)
INSTITUTE_NAME=Training & Placement Cell

# ── JWT Secrets ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=<generate-a-64-byte-hex-string>
JWT_REFRESH_SECRET=<generate-a-different-64-byte-hex-string>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ── Integration Credential Encryption ───────────────────────
# AES-256-GCM key for encrypting provider credentials at rest.
INTEGRATION_ENCRYPTION_KEY=<generate-a-64-char-hex-string>

# ── AI — OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Cloudflare R2 (File Storage) ─────────────────────────────
# Stores question-bank chapter images, resumes/CVs, etc.
# Leave blank to run with uploads disabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=placementos-uploads
R2_PUBLIC_URL=

# ── Judge0 (code execution for coding-type test questions) ───
# Sign up for the "Judge0 CE" API on RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
# Leave blank to run with the "Run" button / coding auto-grading disabled (candidates can still
# write and submit code — it just isn't executed until this is configured).
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ── FRONTEND ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_ENV=development
